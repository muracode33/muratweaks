{
  "name": "muratweaks",
  "productName": "MuraTweaks",
  "version": "1.0.0",
  "description": "Optimizador de Windows open source, sin telemetria ni cuentas",
  "author": "MuraTweaks",
  "main": "main.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/engine.test.js test/engine.integration.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.muratweaks.app",
    "productName": "MuraTweaks",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine/**/*",
      "renderer/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MuraTweaks",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
